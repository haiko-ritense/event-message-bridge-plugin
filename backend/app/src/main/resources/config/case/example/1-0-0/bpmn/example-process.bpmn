<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.39.0">
    <bpmn:collaboration id="Collaboration_1">
        <bpmn:participant id="example-participant" name="Example Process" processRef="example-process"/>
    </bpmn:collaboration>
    <bpmn:process id="example-process" name="Example Process" isExecutable="true">
        <bpmn:startEvent id="start-event" name="Process started">
            <bpmn:outgoing>Flow_1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:startEvent id="emb-event-start" name="EMB event received">
            <bpmn:extensionElements>
                <camunda:executionListener expression="${valueResolverDelegateService.handleValue(execution, 'doc:/embEventId', execution.getVariable('embEventId'))}" event="end"/>
                <camunda:executionListener expression="${valueResolverDelegateService.handleValue(execution, 'doc:/embEventItemId', execution.getVariable('embEventItemId'))}" event="end"/>
            </bpmn:extensionElements>
            <bpmn:outgoing>Flow_2</bpmn:outgoing>
            <bpmn:messageEventDefinition id="MessageEventDefinition_1" messageRef="Message_emb_event"/>
        </bpmn:startEvent>
        <bpmn:endEvent id="end-event" name="Process ended">
            <bpmn:incoming>Flow_1</bpmn:incoming>
            <bpmn:incoming>Flow_2</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_1" sourceRef="start-event" targetRef="end-event"/>
        <bpmn:sequenceFlow id="Flow_2" sourceRef="emb-event-start" targetRef="end-event"/>
    </bpmn:process>
    <bpmn:message id="Message_emb_event" name="example-emb-event"/>
    <bpmndi:BPMNDiagram id="BPMNDiagram_1">
        <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
            <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="example-participant" isHorizontal="true">
                <dc:Bounds x="160" y="100" width="600" height="250"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="start-event">
                <dc:Bounds x="232" y="152" width="36" height="36"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="214" y="195" width="73" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="StartEvent_2_di" bpmnElement="emb-event-start">
                <dc:Bounds x="232" y="252" width="36" height="36"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="203" y="295" width="95" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="end-event">
                <dc:Bounds x="572" y="202" width="36" height="36"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="555" y="245" width="71" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
                <di:waypoint x="268" y="170"/>
                <di:waypoint x="420" y="170"/>
                <di:waypoint x="420" y="220"/>
                <di:waypoint x="572" y="220"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
                <di:waypoint x="268" y="270"/>
                <di:waypoint x="420" y="270"/>
                <di:waypoint x="420" y="220"/>
                <di:waypoint x="572" y="220"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</bpmn:definitions>
